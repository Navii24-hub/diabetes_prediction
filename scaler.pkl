   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "c4efde3a-4b48-4b32-be84-2be2acf7c538",
   "metadata": {},
   "outputs": [],
   "source": [
    "for i in df.select_dtypes(include=['int64', 'float64']).columns:\n",
    "    q1=df[i].quantile(0.25)\n",
    "    q3=df[i].quantile(0.75)\n",
    "    IQR=q3-q1\n",
    "    LB=q1-1.5*IQR\n",
    "    UB=q3+1.5*IQR\n",
    "    df[i]=df[i].clip(LB,UB)"
   ]
  },
